{
  "framework": "angular",
  "trailingSlash": false,
  "redirects": [
    { "source": "/location", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/Civica/server/**"
    }
  }
}
